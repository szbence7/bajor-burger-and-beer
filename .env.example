# Copy to .env and fill in. Never commit .env.
# VITE_* values are public: they are inlined into the client bundle at build time.

# Canonical public origin, used for canonical URLs, Open Graph, JSON-LD and the sitemap.
VITE_SITE_URL=https://bajorburgerandbeer.hu

# Runtime (not baked into the bundle). "true" hides the site from search engines:
# <meta name="robots" content="noindex"> on every page and "Disallow: /" in robots.txt.
# Use on staging deploys. Leave empty in production.
NOINDEX=

# Supabase (runtime, server-only: read by the Node server, never sent to the browser).
# API URL of the self-hosted instance (Kong), e.g. https://supabase.example.hu
SUPABASE_URL=
# The anon (public) key. Row Level Security limits what it can do. The admin panel also hands
# it (with the URL) to the staff's browser for sign-in, live updates and uploads.
SUPABASE_ANON_KEY=
# Optional: the URL browsers use, when SUPABASE_URL is an internal address (e.g. a Docker
# network name) that only the server can reach. Defaults to SUPABASE_URL.
SUPABASE_PUBLIC_URL=
# SECRET. Service role key: the server uses it only to write the notification log.
SUPABASE_SERVICE_ROLE_KEY=

# Booking emails (runtime). Any SMTP provider. Without SMTP_HOST + SMTP_FROM nothing is sent
# and the admin panel's notification log shows every email as "Nem ment ki".
SMTP_HOST=
# 587 (STARTTLS, default) or 465 (TLS; or set SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
# SECRET
SMTP_PASS=
# Sender, e.g. "Bajor Burger & Beer <foglalas@bajorburgerandbeer.hu>"
SMTP_FROM=
# Where new-booking alerts go; defaults to the venue email in site_settings.
NOTIFY_STAFF_EMAIL=

# Local only, never in Coolify or git: direct Postgres connection for applying
# supabase/migrations and supabase/seed.sql with psql (e.g. through an SSH tunnel).
SUPABASE_DB_URL=
